#!/bin/sh
# Enforce Conventional Commits on the subject line: type(scope)!: summary
# Types match .github/CONTRIBUTING.md. Merge/revert/fixup commits generated by git are allowed.
subject=$(head -n1 "$1")
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s' "$subject" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._-]+\))?!?: .+'; then
  echo "commit-msg: subject must follow Conventional Commits, e.g." >&2
  echo "  fix(auth): reject expired refresh tokens" >&2
  echo "got: $subject" >&2
  exit 1
fi
