POSTGRES_DB=boilerplate
POSTGRES_USER=boilerplate
POSTGRES_PASSWORD=change-me
# Host port for Postgres; change if 5432 is taken by another local database.
POSTGRES_PORT=5432
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
REFRESH_TOKEN_TTL=P30D
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Sign-in/registration limits (defaults: 20/min per IP, 10 failures/15 min per email, 10/h per IP).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_IP=20
# RATE_LIMIT_LOGIN_FAILURES_PER_EMAIL=10
# RATE_LIMIT_REGISTER_PER_IP=10
# Optional first admin, created at startup if missing (docs/configuration.md#first-admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
